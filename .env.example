# Local mode is the default. Copy to .env for local overrides. Never commit real values.

SCHOOLSIFT_ENVIRONMENT=local
SCHOOLSIFT_DATABASE_PATH=.schoolsift/schoolsift.db
SCHOOLSIFT_PUBLIC_WEB_URL=http://localhost:3210
SCHOOLSIFT_PUBLIC_API_URL=http://127.0.0.1:8000
SCHOOLSIFT_CONTENT_DIRECTORY=.schoolsift/content
# SCHOOLSIFT_ALLOWED_ORIGINS=http://localhost:3210,http://127.0.0.1:3210

# Provider OAuth (unset means connect is unavailable locally). Tokens are stored in the OS keychain, never in the database.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=

# Request identity: "local" uses a fixed single-caregiver principal and needs
# no token; "cognito" verifies Cognito ID tokens (required in aws mode).
# SCHOOLSIFT_AUTH_MODE=local
# SCHOOLSIFT_COGNITO_ISSUER=
# SCHOOLSIFT_COGNITO_AUDIENCE=

# Web auth (cognito mode only): hosted UI origin + PKCE app client.
# NEXT_PUBLIC_SCHOOLSIFT_AUTH_MODE=local
# NEXT_PUBLIC_SCHOOLSIFT_COGNITO_DOMAIN=
# NEXT_PUBLIC_SCHOOLSIFT_COGNITO_CLIENT_ID=
# NEXT_PUBLIC_SCHOOLSIFT_COGNITO_REDIRECT_URI=

# AWS mode (required when SCHOOLSIFT_ENVIRONMENT=aws; never set locally without approval).
# SCHOOLSIFT_AWS_REGION=
# SCHOOLSIFT_BEDROCK_MODEL_ID=

# Gmail Pub/Sub push webhook (both required together; required in aws mode).
# The OIDC bearer token must be minted for this exact audience by the
# configured Google service account.
# SCHOOLSIFT_GMAIL_PUSH_AUDIENCE=
# SCHOOLSIFT_GMAIL_PUSH_SERVICE_ACCOUNT=

# Gmail watch topic: fully-qualified Google Pub/Sub topic the provider posts
# to (projects/<project>/topics/<topic>). Required for Gmail notification
# registration; Pub/Sub itself is managed outside this stack. Notifications
# also need SCHOOLSIFT_PUBLIC_API_URL to be a public HTTPS origin.
# SCHOOLSIFT_GMAIL_TOPIC=

# AWS adapter wiring (AgentCore runtime / future workers; names only, never values).
# SCHOOLSIFT_CONTENT_BUCKET=
# SCHOOLSIFT_STATE_TABLE=
# SCHOOLSIFT_KMS_KEY_ARN=
# SCHOOLSIFT_SECRET_PREFIX=schoolsift
# SCHOOLSIFT_INGESTION_QUEUE_URL=
# SCHOOLSIFT_EXECUTION_QUEUE_URL=  # must be a .fifo queue; idempotency-key dedupe
# SCHOOLSIFT_AGENT_DATA_FACTORY=
