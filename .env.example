# Local demo mode. Copy to .env for local overrides. Never commit real values.

# "demo" is the only supported mode in this phase.
SCHOOLSIFT_MODE=demo

# Local FastAPI port (web app defaults to http://127.0.0.1:8000).
SCHOOLSIFT_API_PORT=8000

# Phase 4 (live agent) settings — names only, intentionally unset locally.
