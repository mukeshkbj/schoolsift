  "cards": [
    {
      "dot": "cyan",
      "title": "Trust boundaries",
      "items": [
        "Cognito identity and household role on every request",
        "Webhooks verify OIDC / client state, then only enqueue",
        "Refresh tokens never leave Secrets Manager or the keyring"
      ]
    },
    {
      "dot": "amber",
      "title": "Data handling",
      "items": [
        "Bodies and attachments encrypted, referenced by opaque IDs",
        "Only confirmed school senders are read in full",
        "Raw content expires after 30 days"
      ]
    },
    {
      "dot": "rose",
      "title": "Action safety",
      "items": [
        "Model output is validated before it becomes an Action Packet",
        "A caregiver approves each reply, event, or PDF before execution",
        "Payments and binding signatures are never automated"
      ]
    }
  ]
